{
  "name": "acri-journals",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ACRI Journals — static journal network site, PDF pipeline and editorial portal",
  "scripts": {
    "ingest": "node build/ingest.mjs",
    "build": "node build/build.mjs",
    "pdf": "node build/pdf.mjs",
    "all": "node build/ingest.mjs && node build/build.mjs && node build/pdf.mjs",
    "templates": "node templates/src/make-templates.mjs",
    "import-legacy": "node build/import-legacy.mjs",
    "serve": "npx --yes serve dist -l 8080",
    "test:sample": "cp -r samples/IJBMRS-2026-901 content/incoming/ && node build/ingest.mjs --keep"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "^1.50.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "docx": "^9.0.0"
  },
  "engines": { "node": ">=20" }
}
